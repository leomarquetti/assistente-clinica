# Configurações do Assistente de Atendimento para Clínicas (Modo Demo)
APP_MODE=demo
LLM_PROVIDER=mock        # mock | real
STORAGE=memory           # memory | sqlite
CONFIDENCE_THRESHOLD=0.6
SQLITE_DB_PATH=clinic_demo.db

# Chaves de acesso da demonstração (devem ser substituídas em ambientes controlados)
API_KEY_ATENDENTE=demo-atendente-key
API_KEY_GESTOR=demo-gestor-key

RATE_LIMIT_DEFAULT=60/minute

# LLM_API_KEY=           # mock | demo
